# 프로파일 명시는 컴파일 타임이 아니라 런타임에 명시하여
# Build Once, Run Everywhere 원칙으로 하나의 이미지를 여러 프로파일 환경에서 사용할 수 있도록
export SPRING_PROFILES_ACTIVE=

# Docker Compose 내 데이터베이스 컨테이너를 구동하여 접속하기 위한 정보
# HOST / DATABASE 명을 나누지 않고 하나의 URL 로 하는 이유는 H2 처럼 호스트나 포트 개념이 없는 데이터베이스도 있기 때문
export DATASOURCE_URL=
export DATASOURCE_DATABASE=
export DATASOURCE_USERNAME=
export DATASOURCE_PASSWORD=

# ① 현재 프로젝트의 루트 디렉토리에서 AWS CLI 명령어도 사용할때 활용할 수 있도록
# ② AwsProperties 클래스 내 @Configuration 통해 환경변수값을 가져다 변수로 활용할 수 있도록
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_REGION='ap-northeast-2'